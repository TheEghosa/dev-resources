# This is a template only. setup.sh writes the real file, called .env, on your
# server, and that real file must never be committed, because this repository is
# public and .env holds secrets.

# The address you chose for n8n, without https:// in front of it.
N8N_HOSTNAME=n8n.example.com

# Your local timezone, so that scheduled workflows run at the times you expect.
# Use a name from the tz database, such as Africa/Lagos or Europe/London.
GENERIC_TIMEZONE=Etc/UTC

# The long token Cloudflare shows when you create the tunnel. It starts with eyJ.
CLOUDFLARE_TUNNEL_TOKEN=paste-your-tunnel-token-here

# A random 64 character key that encrypts the logins you save in n8n. setup.sh
# generates it. If you lose it, n8n can no longer read those saved logins.
N8N_ENCRYPTION_KEY=generated-by-setup-sh
